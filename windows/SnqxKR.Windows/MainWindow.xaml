<Window x:Class="SnqxKR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="소전2 한글패치" Icon="app.ico" Width="760" Height="780" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <Grid Margin="24,20,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="소전2 한글패치" FontSize="26" FontWeight="SemiBold" />
            <TextBlock Text="중섭 PC 클라이언트(官服·B服) 전용 · 글로벌·한국 서버 클라이언트는 건드리지 않습니다"
                       Foreground="{DynamicResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 1. 게임 선택 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="한글패치할 게임을 선택하세요" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="FindText" Foreground="{DynamicResource SubText}" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <ListBox x:Name="GameList" Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource GameItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="GameList_SelectionChanged">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource SubText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="게임을 찾지 못했습니다. 실행 파일(GF2_Exilium.exe / PCLauncher.exe)을 직접 고르거나 관리자 권한으로 전체 스캔하세요." />
                        <WrapPanel Margin="0,4,0,0">
                            <Button x:Name="RefreshButton" Content="다시 찾기" Click="Refresh_Click" Margin="0,0,8,8" />
                            <Button x:Name="PickButton" Content="실행 파일 직접 선택" Click="Pick_Click" Margin="0,0,8,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,8,8">
                                <Button x:Name="ScanButton" Click="Scan_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="관리자 권한으로 전체 스캔" />
                                    </StackPanel>
                                </Button>
                                <!-- 고급 설정: 훑을 루트 드라이브 고르기 -->
                                <Button x:Name="ScanOptionsButton" Click="ScanOptions_Click" Padding="9,8" Margin="2,0,0,0" ToolTip="고급 설정">
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" />
                                </Button>
                                <Popup x:Name="ScanOptions" PlacementTarget="{Binding ElementName=ScanOptionsButton}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True" VerticalOffset="4" Closed="ScanOptions_Closed">
                                    <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                                            CornerRadius="6" Padding="14,12" MaxWidth="420">
                                        <StackPanel>
                                            <TextBlock Text="전체 스캔할 드라이브" FontWeight="SemiBold" />
                                            <TextBlock Foreground="{DynamicResource SubText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"
                                                       Text="NTFS 파일 목록(MFT)만 읽을 수 있어 NTFS 가 아닌 드라이브는 고를 수 없습니다. 그런 곳은 Everything 을 켜 두거나 실행 파일을 직접 고르세요." />
                                            <StackPanel x:Name="DrivePanel" />
                                            <TextBlock x:Name="ScanNote" Foreground="{DynamicResource Accent}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 2. 선택한 게임 -->
                <Border x:Name="DetailCard" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Border x:Name="Hero" CornerRadius="8" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="HeroTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="HeroBody" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <ProgressBar x:Name="Progress" Height="6" Margin="0,12,0,0" Visibility="Collapsed"
                                     Foreground="{DynamicResource Accent}" Background="{DynamicResource ButtonBg}" BorderThickness="0" />
                        <TextBlock x:Name="ProgressText" Foreground="{DynamicResource SubText}" Margin="0,4,0,0" Visibility="Collapsed" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}" Click="Primary_Click" Margin="0,0,8,8" MinWidth="170" />
                            <Button x:Name="CheckButton" Content="업데이트 확인" Click="Check_Click" Margin="0,0,8,8" />
                            <Button x:Name="RestoreButton" Content="원본 복원" Click="Restore_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="ResultText" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
                        <TextBlock x:Name="NoteText" Foreground="{DynamicResource SubText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6" />
                        <StackPanel x:Name="InfoPanel" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- 3. 저장 공간 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="StorageTotal" DockPanel.Dock="Right" Foreground="{DynamicResource SubText}" VerticalAlignment="Center" />
                            <TextBlock Text="저장 공간" FontSize="17" FontWeight="SemiBold" />
                        </DockPanel>
                        <StackPanel x:Name="StoragePanel" Margin="0,8,0,0" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button x:Name="OpenDataButton" Content="데이터 폴더 열기" Click="OpenData_Click" Margin="0,0,8,0" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 4. 기록 -->
                <Expander Header="기록" Margin="0,12,0,0">
                    <TextBox x:Name="LogBox" IsReadOnly="True" Height="170" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="{DynamicResource SubText}" BorderThickness="0"
                             FontFamily="Consolas, Malgun Gothic" FontSize="12" Margin="0,6,0,0" />
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="FooterText" Foreground="{DynamicResource SubText}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
